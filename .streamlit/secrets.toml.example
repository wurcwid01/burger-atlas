# Copy to .streamlit/secrets.toml (never commit the real file),
# or paste these lines into Streamlit Cloud → App settings → Secrets.
# Leave the Google keys empty to run with fictional sample data.

# Server key: restricted to "Places API (New)". Never reaches the browser.
GOOGLE_PLACES_API_KEY = ""
# Browser key: restricted to "Maps JavaScript API" + your app's website address.
GOOGLE_MAPS_BROWSER_KEY = ""

# Optional
# GOOGLE_MAP_ID = "DEMO_MAP_ID"   # custom map style ID, if you make one
# PLACES_MAX_PAGES = 2            # 20 results per page; 1 search per page per visitor session
# DETAIL_PHOTOS = 1               # Google photos on the details page (each is billed)
